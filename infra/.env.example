# Copiar a infra/.env y completar. Nunca versionar infra/.env.

POSTGRES_USER=carpooling
POSTGRES_PASSWORD=carpooling
POSTGRES_DB=carpooling
DATABASE_URL=postgresql+psycopg://carpooling:carpooling@localhost:5432/carpooling

VALHALLA_URL=http://localhost:8002
VALHALLA_THREADS=4

# D1 pendiente: completar con la sede confirmada.
# Formato: izquierda,abajo,derecha,arriba (longitud,latitud).
ZONE_BBOX=PENDIENTE_D1
OSM_SOURCE_URL=PENDIENTE_D1

# Umbrales propuestos por el brief. Ajustar con las primeras pruebas.
SEARCH_RADIUS_M=800
PREFILTER_M=600
MAX_DETOUR_S=600
DESVIO_MAX_PCT=0.15

# D4 pendiente: estilo de teselas para MapLibre.
TILE_STYLE_URL=
